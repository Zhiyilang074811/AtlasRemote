//! ATLS Protocol v1 — PacketType 枚举//!//! 定义所有包类型，用于协议头中的 TYPE 字段（2 bytes）。/// ATLS Protocol v1 packet types#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]#[repr(u16)]pub enum PacketType {    /// 视频帧 (H264/H265/BGRA)    Frame = 1,    /// 输入事件 (鼠标/键盘)    Input = 2,    /// 控制命令 (分辨率/质量设置)    Control = 3,    /// 配对请求 (客户端发起)    PairRequest = 4,    /// 配对响应 (服务端回复)    PairResponse = 5,    /// 心跳请求    Ping = 6,    /// 心跳响应    Pong = 7,}impl PacketType {    /// 从 u16 反序列化，未知类型返回 None    pub fn from_u16(v: u16) -> Option<Self> {        match v {            1 => Some(PacketType::Frame),            2 => Some(PacketType::Input),            3 => Some(PacketType::Control),            4 => Some(PacketType::PairRequest),            5 => Some(PacketType::PairResponse),            6 => Some(PacketType::Ping),            7 => Some(PacketType::Pong),            _ => None,        }    }    /// 序列化为 u16    pub fn to_u16(self) -> u16 {        self as u16    }}impl std::fmt::Display for PacketType {    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {        match self {            PacketType::Frame => write!(f, "FRAME"),            PacketType::Input => write!(f, "INPUT"),            PacketType::Control => write!(f, "CONTROL"),            PacketType::PairRequest => write!(f, "PAIR_REQ"),            PacketType::PairResponse => write!(f, "PAIR_RESP"),            PacketType::Ping => write!(f, "PING"),            PacketType::Pong => write!(f, "PONG"),        }    }}/// Magic bytes that identify an ATLS packetpub const ATLS_MAGIC: [u8; 4] = [b'A', b'T', b'L', b'S'];/// Current protocol versionpub const ATLS_VERSION: u16 = 1;/// Size of the fixed header in bytespub const HEADER_SIZE: usize = 24;/// Frame codec type - identifies the encoding of the payload#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]#[repr(u16)]pub enum FrameType {    /// Uncompressed BGRA (v1 compatible)    Bgra = 1,    /// H264 compressed    H264 = 2,    /// H265 compressed    H265 = 3,}impl FrameType {    pub fn from_u16(v: u16) -> Option<Self> {        match v {            1 => Some(FrameType::Bgra),            2 => Some(FrameType::H264),            3 => Some(FrameType::H265),            _ => None,        }    }    pub fn to_u16(self) -> u16 {        self as u16    }}impl std::fmt::Display for FrameType {    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {        match self {            FrameType::Bgra => write!(f, "BGRA"),            FrameType::H264 => write!(f, "H264"),            FrameType::H265 => write!(f, "H265"),        }    }}#[cfg(test)]mod tests {    use super::*;    #[test]    fn test_all_types_roundtrip() {        for t in [            PacketType::Frame,            PacketType::Input,            PacketType::Control,            PacketType::PairRequest,            PacketType::PairResponse,            PacketType::Ping,            PacketType::Pong,        ] {            assert_eq!(PacketType::from_u16(t.to_u16()), Some(t));        }    }    #[test]    fn test_unknown_type() {        assert!(PacketType::from_u16(0).is_none());        assert!(PacketType::from_u16(8).is_none());        assert!(PacketType::from_u16(0xFFFF).is_none());    }    #[test]    fn test_magic_bytes() {        assert_eq!(&ATLS_MAGIC[..], b"ATLS");    }    #[test]    fn test_header_size() {        assert_eq!(HEADER_SIZE, 24);    }}